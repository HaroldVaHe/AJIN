# === N8N (futuro) ===
# NEXT_PUBLIC_N8N_WEBHOOK_BASE=https://tun8n.app.n8n.cloud/webhook

# === Telegram (temporal gratis) ===
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# === Supabase (marketplace de inmuebles) — SIN prefijo NEXT_PUBLIC_ para poder marcarlas Sensitive en Vercel ===
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
ADMIN_EMAILS=
CRON_SECRET=
# Opcional: secreto HMAC propio para el token de subida de fotos
UPLOAD_TOKEN_SECRET=

# === Cerebro interno (IA) ===
# AI_PROVIDER=openai | gemini | mock   (si se omite: se detecta por la llave)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# AI_EMBEDDING_MODEL=
# AI_CHAT_MODEL=
# AI_CACHE_ENABLED=true
# AI_CACHE_THRESHOLD=0.97
# AI_CACHE_TTL_DAYS=14
# KNOWLEDGE_INCLUDE_PII=false   (true incluye teléfonos/correos/documentos de contratos)
